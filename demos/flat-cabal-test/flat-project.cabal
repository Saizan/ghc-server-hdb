cabal-version:      3.0
name:               flat-project
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Andrea Vezzosi
maintainer:         andrea@well-typed.com
-- copyright:
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  M0, M1
    -- other-modules:
    -- other-extensions:
    build-depends:    base ^>=4.22.0.0
    hs-source-dirs:   unit1
    default-language: GHC2024
    ghc-options:
        -fprefer-byte-code -fbyte-code-and-object-code -fwrite-if-simplified-core -fbreak-points